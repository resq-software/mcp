# Shim. The real CLI is the `resq` binary installed by resq-software/dev
# (see bootstrap.sh); this forwards to it so `./resq <cmd>` works from the
# repo regardless of PATH ordering.
#
# The previous version resolved the repo root and sourced "$ROOT_DIR/resq" --
# itself -- so every invocation recursed until killed. Skip this file explicitly
# when scanning PATH.

set -euo pipefail

self="${BASH_SOURCE[0]}"

# `-ef` compares device+inode, so it identifies this file through any path
# without `readlink -f`, which is GNU-only -- flake.nix targets darwin too.
target=""
while IFS= read -r candidate; do
  if [ ! -x "$candidate" ]; then continue; fi
  if [ "$candidate" -ef "$self" ]; then continue; fi
  target=$candidate
  break
done < <(type -a -P resq 2>/dev/null || true)

if [ -z "$target" ]; then
  cat >&2 <<'MSG'
resq: the ResQ CLI is not installed or is not on PATH.

Install it with the repo bootstrap:

    ./bootstrap.sh

See https://github.com/resq-software/dev for the installer.
MSG
  exit 127
fi

exec "$target" "$@"
